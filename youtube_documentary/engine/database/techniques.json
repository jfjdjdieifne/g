  "techniques": [
    {
      "id": "T01",
      "name": "camera_guided_evidence_connection",
      "complexity": 4,
      "purpose": "Reveal a relationship between 2+ subjects by traveling between them along a designed path on a shared spatial canvas.",
      "inputs": [
        "subject_assets",
        "subject_rects",
        "relationship",
        "word_timestamps"
      ],
      "params": {
        "path_curve": "bezier",
        "connection_style": "pin|string|inkline|none",
        "dwell_ease": [
          0.35,
          0.4,
          0.25
        ],
        "subject_scale_range": [
          0.18,
          0.55
        ],
        "canvas_material": "photographic_board"
      },
      "outputs": [
        "camera_keys",
        "connection_layer",
        "typography_anchors"
      ],
      "implementation": {
        "renderer": "three_planes+svg_world_path",
        "camera": "follow_path_tangent"
      },
      "pairs_with": [
        "T02",
        "T04",
        "T08"
      ],
      "qc_checks": [
        "label_readable_before_onset",
        "no_subject_overlap",
        "path_dwell>=readable_time"
      ],
      "evidence": [
        "INFERRED (MagnatesMedia board grammar)",
        "PIPELINE (AE-based)"
      ],
      "anti_patterns": [
        "thin floating rectangles",
        "dark void canvas",
        "meaningless arrow"
      ]
    },
    {
      "id": "T02",
      "name": "spatial_env_takeover",
      "complexity": 2,
      "purpose": "Full-bleed archival photograph becomes the world; typography lives inside it.",
