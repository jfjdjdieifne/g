          -0.006
        ],
        "scrims": [
          "directional",
          "bottom"
        ],
        "entrance": "fade_from_black",
        "exit": "crossfade_or_token_match"
      },
      "pairs_with": [
        "T12",
        "T04"
      ],
      "qc_checks": [
        "photo_coverage>=0.95_frame",
        "text_contrast>=4.5:1"
      ],
      "evidence": [
